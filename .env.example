# Environment Configuration
# Copy to .env and fill in your values. Never commit .env to git.

# ─── App ─────────────────────────────────────────────────────────────────────
APP_ENV=development                       # development | staging | production
LOG_LEVEL=debug                           # trace | debug | info | warn | error
LOG_FORMAT=pretty                         # pretty | json

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_USER=agrisense
POSTGRES_PASSWORD=secret                   # local development only
POSTGRES_DB=agrisense
DATABASE_URL=postgres://agrisense:secret@localhost:5432/agrisense
# Dedicated URL-safe runtime passwords. Use different random values in production.
BRAIN_DB_PASSWORD=brain-local-only
GATEWAY_DB_PASSWORD=gateway-local-only
FARM_DB_PASSWORD=farm-local-only
AGRONOMY_DB_PASSWORD=agronomy-local-only
FINANCE_DB_PASSWORD=finance-local-only
MARKETPLACE_DB_PASSWORD=marketplace-local-only
ANALYTICS_DB_PASSWORD=analytics-local-only
PLATFORM_DB_PASSWORD=platform-local-only
DATABASE_MAX_CONNECTIONS=20
DATABASE_MIN_CONNECTIONS=2

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_MAX_CONNECTIONS=10

# ─── Conversation Memory ──────────────────────────────────────────────────────
CONVERSATION_MEMORY_TTL_SECONDS=86400      # 24 hours
CONVERSATION_MEMORY_MAX_MESSAGES=8         # user + assistant messages
CONVERSATION_MEMORY_MAX_CHARS=12000         # bounded Redis/prompt payload

# ─── NATS JetStream ───────────────────────────────────────────────────────────
NATS_URL=nats://localhost:4222
NATS_STREAM_NAME=AGRISENSE

# ─── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-in-production-use-256-bit-random
JWT_EXPIRY_SECONDS=86400                  # 24 hours
REFRESH_TOKEN_EXPIRY_SECONDS=2592000      # 30 days

# ─── Internal Service Authentication ──────────────────────────────────────────
# Generate distinct random values with at least 32 bytes for every boundary.
GATEWAY_BRAIN_TOKEN=
BRAIN_AI_TOKEN=
BRAIN_FARM_TOKEN=
MCP_REGISTRATION_TOKEN=

# ─── WhatsApp Business API ────────────────────────────────────────────────────
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_GRAPH_API_VERSION=v25.0
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_BUSINESS_ACCOUNT_ID=

# ─── ElevenLabs WhatsApp Voice Notes ──────────────────────────────────────────
# Voice support is enabled only when both API key and voice ID are set.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_STT_MODEL=scribe_v2
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
ELEVENLABS_LANGUAGE_CODE=id
ELEVENLABS_TTS_OUTPUT_FORMAT=mp3_44100_128

# ─── Gemini Text + Vision ──────────────────────────────────────────────────────
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Speech/embeddings/moderation/RAG return HTTP 501.

# ─── Google Cloud ─────────────────────────────────────────────────────────────
GCP_PROJECT_ID=
GCP_REGION=asia-southeast2
GCS_BUCKET_NAME=agrisense-media
GOOGLE_APPLICATION_CREDENTIALS=

# ─── Observability ────────────────────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=agrisense
PROMETHEUS_PORT=9090

# ─── Service Ports ────────────────────────────────────────────────────────────
WHATSAPP_GATEWAY_PORT=3001
BRAIN_SERVICE_PORT=3002
FARM_SERVICE_PORT=3003
AGRONOMY_SERVICE_PORT=3004
FINANCE_SERVICE_PORT=3005
MARKETPLACE_SERVICE_PORT=3006
ANALYTICS_SERVICE_PORT=3007
AI_SERVICE_PORT=3008
PLATFORM_SERVICE_PORT=3009

# ─── Service URLs (internal) ──────────────────────────────────────────────────
BRAIN_SERVICE_URL=http://localhost:3002
FARM_SERVICE_URL=http://localhost:3003
AGRONOMY_SERVICE_URL=http://localhost:3004
FINANCE_SERVICE_URL=http://localhost:3005
MARKETPLACE_SERVICE_URL=http://localhost:3006
AI_SERVICE_URL=http://localhost:3008
PLATFORM_SERVICE_URL=http://localhost:3009

# ─── MCP ──────────────────────────────────────────────────────────────────────
MCP_REGISTRY_URL=http://localhost:3002/mcp
