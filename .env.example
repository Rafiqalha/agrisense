# Environment Configuration
# Copy to .env and fill in your values. Never commit .env to git.

# ─── App ─────────────────────────────────────────────────────────────────────
APP_ENV=development                       # development | staging | production
LOG_LEVEL=debug                           # trace | debug | info | warn | error
LOG_FORMAT=pretty                         # pretty | json

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
DATABASE_URL=postgres://agrisense:secret@localhost:5432/agrisense
DATABASE_MAX_CONNECTIONS=20
DATABASE_MIN_CONNECTIONS=2

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_MAX_CONNECTIONS=10

# ─── NATS JetStream ───────────────────────────────────────────────────────────
NATS_URL=nats://localhost:4222
NATS_STREAM_NAME=AGRISENSE

# ─── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-in-production-use-256-bit-random
JWT_EXPIRY_SECONDS=86400                  # 24 hours
REFRESH_TOKEN_EXPIRY_SECONDS=2592000      # 30 days

# ─── WhatsApp Business API ────────────────────────────────────────────────────
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_BUSINESS_ACCOUNT_ID=

# ─── AI Providers ─────────────────────────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AI_PROVIDER=gemini                        # gemini | openai | anthropic | local

# ─── Google Cloud ─────────────────────────────────────────────────────────────
GCP_PROJECT_ID=
GCP_REGION=asia-southeast2
GCS_BUCKET_NAME=agrisense-media
GOOGLE_APPLICATION_CREDENTIALS=

# ─── Observability ────────────────────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=agrisense
PROMETHEUS_PORT=9090

# ─── Service Ports ────────────────────────────────────────────────────────────
WHATSAPP_GATEWAY_PORT=3001
BRAIN_SERVICE_PORT=3002
FARM_SERVICE_PORT=3003
AGRONOMY_SERVICE_PORT=3004
FINANCE_SERVICE_PORT=3005
MARKETPLACE_SERVICE_PORT=3006
ANALYTICS_SERVICE_PORT=3007
AI_SERVICE_PORT=3008
PLATFORM_SERVICE_PORT=3009

# ─── Service URLs (internal) ──────────────────────────────────────────────────
BRAIN_SERVICE_URL=http://localhost:3002
FARM_SERVICE_URL=http://localhost:3003
AGRONOMY_SERVICE_URL=http://localhost:3004
FINANCE_SERVICE_URL=http://localhost:3005
MARKETPLACE_SERVICE_URL=http://localhost:3006
AI_SERVICE_URL=http://localhost:3008
PLATFORM_SERVICE_URL=http://localhost:3009

# ─── MCP ──────────────────────────────────────────────────────────────────────
MCP_REGISTRY_URL=http://localhost:3002/mcp
